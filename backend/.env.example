# Local FastAPI and Vite development defaults. No secrets belong in this file.
APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173

MAX_TEXT_LENGTH=10000
MAX_IMAGE_BYTES=5242880
MAX_AUDIO_BYTES=10485760

MODEL_DEVICE=cpu
TEXT_MODEL_NAME=j-hartmann/emotion-english-distilroberta-base
IMAGE_MODEL_NAME=baseline
AUDIO_MODEL_NAME=baseline
COACH_PROVIDER=baseline

# Hugging Face Inference provider settings (local only, do not commit real tokens)
HF_API_TOKEN=your_huggingface_token_here
HF_INFERENCE_PROVIDER=hf-inference
HF_INFERENCE_API_URL=
TEXT_MODEL_TIMEOUT_SECONDS=10.0

# Development only: must be explicitly set to true to allow heuristic baseline (strictly rejected in production)
ALLOW_DEV_BASELINE=false

DATABASE_URL=sqlite:///./data/emotioniq.db
AUTH_ENABLED=true
JWT_SIGNING_SECRET=replace-this-with-a-local-random-secret
