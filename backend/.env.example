# Local FastAPI and Vite development defaults. No secrets belong in this file.
APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173

MAX_TEXT_LENGTH=10000
MAX_IMAGE_BYTES=5242880
MAX_AUDIO_BYTES=10485760

MODEL_DEVICE=cpu
TEXT_MODEL_NAME=baseline
IMAGE_MODEL_NAME=baseline
AUDIO_MODEL_NAME=baseline
COACH_PROVIDER=baseline

DATABASE_URL=sqlite:///./data/emotioniq.db
AUTH_ENABLED=true
