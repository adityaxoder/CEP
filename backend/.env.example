# Local FastAPI and Vite development defaults. No secrets belong in this file.
APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173

MAX_TEXT_LENGTH=10000
MAX_IMAGE_BYTES=5242880
MAX_AUDIO_BYTES=10485760

MODEL_DEVICE=cpu
TEXT_MODEL_NAME=gemini-3.1-flash-lite
IMAGE_MODEL_NAME=baseline
AUDIO_MODEL_NAME=baseline
COACH_PROVIDER=gemini

# Gemini API settings. Put your key only in the ignored backend/.env file.
GEMINI_API_KEY=
TEXT_MODEL_TIMEOUT_SECONDS=45.0

# Legacy provider settings are unused by the classroom demo.
HF_API_TOKEN=
HF_INFERENCE_PROVIDER=hf-inference
HF_INFERENCE_API_URL=


DATABASE_URL=sqlite:///./data/emotioniq.db
AUTH_ENABLED=true
JWT_SIGNING_SECRET=replace-this-with-a-local-random-secret
